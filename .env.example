# Optional PostgreSQL mode.
# If DATABASE_URL is empty or .env is absent, RedCord 0.4 uses local SQLite:
#   data/redcord.db
#
# For PostgreSQL, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/record_db

APP_ENV=development
LOG_LEVEL=INFO
REDCORD_THEME=dark_red
COMMIT_DIR=./commits
DATA_DIR=./data
# ASSETS_DIR normally does not need to be changed.
